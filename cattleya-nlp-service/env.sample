# Python NLP Service Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# API Keys and External Services
# =============================================================================

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# SerpAPI for Web Search (Primary)
SERPAPI_API_KEY=your_serpapi_key_here

# Google Custom Search (Fallback)
GOOGLE_CSE_ID=your_google_cse_id_here
GOOGLE_API_KEY=your_google_api_key_here

# =============================================================================
# Database Configuration
# =============================================================================

# MongoDB Connection (if using MongoDB for conversation memory)
MONGODB_URI=mongodb://localhost:27017/cattleya_nlp
MONGODB_DATABASE=cattleya_nlp
MONGODB_COLLECTION=conversations

# Redis Configuration (for caching and session management)
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_PASSWORD=

# =============================================================================
# Service Configuration
# =============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourdomain.com

# =============================================================================
# NLP and AI Configuration
# =============================================================================

# spaCy Model
SPACY_MODEL=en_core_web_sm

# Sentiment Analysis
SENTIMENT_ANALYSIS_ENABLED=true
SENTIMENT_THRESHOLD=0.1

# Voice Transcription (if using speech recognition)
SPEECH_RECOGNITION_ENABLED=true
SPEECH_RECOGNITION_LANGUAGE=en-US

# =============================================================================
# Cattleya Orchid Knowledge Configuration
# =============================================================================

# Knowledge Base Settings
KNOWLEDGE_CACHE_TTL=3600  # 1 hour in seconds
MAX_SEARCH_RESULTS=5
MIN_RELEVANCE_SCORE=0.7

# Orchid Care Information Sources
ORCHID_CARE_SOURCES=https://www.aos.org,https://www.orchidweb.com,https://www.orchids.org

# =============================================================================
# Security and Rate Limiting
# =============================================================================

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600  # 1 hour in seconds

# API Security
API_KEY_HEADER=X-API-Key
API_KEY=your_internal_api_key_here

# =============================================================================
# Logging and Monitoring
# =============================================================================

# Logging Configuration
LOG_FILE=logs/nlp_service.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# =============================================================================
# Development and Testing
# =============================================================================

# Development Mode
ENVIRONMENT=development
ENABLE_HOT_RELOAD=true

# Testing
TEST_MODE=false
MOCK_EXTERNAL_APIS=false

# =============================================================================
# Integration with Node.js Backend
# =============================================================================

# Node.js Backend URL
NODEJS_BACKEND_URL=http://localhost:3001
NODEJS_API_KEY=your_nodejs_backend_api_key_here

# =============================================================================
# Optional: Advanced Features
# =============================================================================

# Web Scraping Configuration
ENABLE_WEB_SCRAPING=true
SCRAPING_TIMEOUT=30
SCRAPING_USER_AGENT=Mozilla/5.0 (compatible; CattleyaNLP/1.0)

# Image Analysis (if implementing image recognition)
ENABLE_IMAGE_ANALYSIS=false
VISION_API_KEY=your_vision_api_key_here

# Translation Services (if implementing multi-language support)
TRANSLATION_ENABLED=false
TRANSLATION_API_KEY=your_translation_api_key_here

# =============================================================================
# Performance and Optimization
# =============================================================================

# Async Processing
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=30

# Caching
ENABLE_CACHE=true
CACHE_TTL=1800  # 30 minutes

# Memory Management
MAX_MEMORY_USAGE=512MB
GARBAGE_COLLECTION_INTERVAL=300  # 5 minutes 