// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/@prisma/client"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String    @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  role      UserRole  @default(CUSTOMER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isBlocked Boolean   @default(false)
  blockedAt DateTime?
  lastLogin DateTime?
  avatar    String?
  addresses Address[]
  dateOfBirth DateTime?

  // Account status
  blockedBy   String? @db.ObjectId
  blockReason String?

  // Orders
  orders Order[]

  // Customer specific
  loyaltyPoints Int            @default(0)
  wishlist      Wishlist?
  cart          Cart?
  reviews       Review[]
  CartItem      CartItem[]
  WishlistItem  WishlistItem[]

  // Payment methods
  paymentMethods PaymentMethod[]

  // Notifications
  notifications Notification[]

  // Chat messages
  chatMessages ChatMessage[]

  @@index([role])
  @@index([isBlocked])
  @@index([createdAt])
  @@map("users")
}

model Address {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  userId    String  @db.ObjectId
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "shipping" or "billing"
  label     String?
  firstName String
  lastName  String
  company   String?
  street    String
  apartment String?
  city      String
  state     String
  zipCode   String
  country   String
  phone     String?
  isDefault Boolean @default(false)

  // Orders using this address
  shippingOrders Order[] @relation("ShippingAddress")
  billingOrders  Order[] @relation("BillingAddress")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([isDefault])
  @@map("addresses")
}

model Category {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  name        String     @unique
  slug        String     @unique
  description String?
  icon        String?
  parentId    String?    @db.ObjectId
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Category[] @relation("CategoryHierarchy")

  // Products in this category
  products Product[]

  // SEO
  metaTitle       String?
  metaDescription String?

  // Status
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([isActive])
  @@index([sortOrder])
  @@map("categories")
}

model AttributeSet {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  
  // Attributes in this set
  attributes Attribute[]
  
  // Products using this attribute set
  products Product[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("attribute_sets")
}

model Attribute {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  attributeSetId String      @db.ObjectId
  attributeSet   AttributeSet @relation(fields: [attributeSetId], references: [id], onDelete: Cascade)
  
  name        String
  code        String        @unique
  type        AttributeType
  isRequired  Boolean       @default(false)
  isSearchable Boolean      @default(false)
  isFilterable Boolean      @default(false)
  isComparable Boolean      @default(false)
  isVisible   Boolean       @default(true)
  isVariantDefining Boolean @default(false)
  isVariantOverridable Boolean @default(false)
  sortOrder   Int           @default(0)
  
  // For select/radio/checkbox types - now supports default values
  options     Json          @default("[]") // Array of objects: [{ "value": "red", "label": "Red", "isDefault": false }, { "value": "blue", "label": "Blue", "isDefault": true }]
  
  // For number types
  minValue    Float?
  maxValue    Float?
  unit        String?       // e.g., "cm", "kg", "months"
  
  // For text types
  maxLength   Int?
  pattern     String?       // regex pattern for validation
  
  // For color type
  allowCustom Boolean       @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([attributeSetId])
  @@index([type])
  @@index([sortOrder])
  @@map("attributes")
}

model Product {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String  @unique
  sku       String  @unique

  // Descriptions
  description      String
  shortDescription String?

  // Pricing
  basePrice Float
  salePrice Float?
  isOnSale  Boolean @default(false)
  costPrice Float?

  // Stock
  stockQuantity    Int  @default(0)
  lowStockThreshold Int @default(5)
  trackQuantity    Boolean @default(true)

  // Physical properties
  weight     Float?
  dimensions String? // "LxWxH in cm"

  // Orchid-specific properties
  defaultSize     OrchidSize
  availableSizes  OrchidSize[]
  primaryColors   String[] // Main colors (for bicolor/multicolor)
  colorPattern    ColorPattern

  // Category
  categoryId String   @db.ObjectId
  category   Category @relation(fields: [categoryId], references: [id])

  // Attribute Set
  attributeSetId String?      @db.ObjectId
  attributeSet   AttributeSet? @relation(fields: [attributeSetId], references: [id])

  // Attributes (care instructions, origin, etc.)
  attributes ProductAttribute[]

  // Tags
  tags String[]

  // SEO
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[]

  // Status
  isActive    Boolean   @default(true)
  isFeatured  Boolean   @default(false)
  isDigital   Boolean   @default(false)
  publishedAt DateTime?

  // Analytics
  averageRating Float @default(0)
  totalReviews  Int   @default(0)
  totalSales    Int   @default(0)
  viewCount     Int   @default(0)

  // Reviews
  reviews Review[]

  // Wishlist and Cart
  wishlistItems WishlistItem[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  // Images
  images ProductImage[]

  // Variants
  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Performance indexes
  @@index([categoryId])
  @@index([attributeSetId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([isOnSale])
  @@index([basePrice])
  @@index([salePrice])
  @@index([stockQuantity])
  @@index([averageRating])
  @@index([totalSales])
  @@index([viewCount])
  @@index([publishedAt])
  @@index([tags])
  @@index([primaryColors])
  @@index([defaultSize])
  @@index([colorPattern])
  @@map("products")
}

model ProductVariant {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  productId   String   @db.ObjectId
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String   @unique
  price       Float
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  attributes  Json     // e.g. { "size": "Mature", "color": "Yellow" }
  images      ProductImage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String
  isMain    Boolean     @default(false)
  sortOrder Int         @default(0)
  color     String? // Associated color for the image
  size      OrchidSize? // Associated size for the image
  variantId String? @db.ObjectId
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  createdAt DateTime @default(now())
  @@map("product_images")
}

model ProductAttribute {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name  String
  value String

  @@map("product_attributes")
}

model CartItem {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  userId    String  @db.ObjectId
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity           Int
  selectedAttributes Json? // Store selected attributes as JSON

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Cart      Cart?    @relation(fields: [cartId], references: [id])
  cartId    String?  @db.ObjectId

  @@unique([userId, productId])
  @@map("cart_items")
}

model WishlistItem {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  userId    String  @db.ObjectId
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  Wishlist   Wishlist? @relation(fields: [wishlistId], references: [id])
  wishlistId String?   @db.ObjectId

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Order {
  id     String      @id @default(auto()) @map("_id") @db.ObjectId
  number String      @unique
  status OrderStatus @default(PENDING)

  // Customer
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  // Contact
  email String
  phone String?

  // Addresses
  shippingAddressId String  @db.ObjectId
  shippingAddress   Address @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddressId  String  @db.ObjectId
  billingAddress    Address @relation("BillingAddress", fields: [billingAddressId], references: [id])

  // Items
  items OrderItem[]

  // Pricing
  subtotal    Float
  taxAmount   Float @default(0)
  shippingFee Float @default(0)
  discount    Float @default(0)
  total       Float

  // Payment
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?
  paidAt        DateTime?

  // Shipping
  shippingMethod String?
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  // Notes
  notes         String?
  customerNotes String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model OrderItem {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  orderId String @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])

  quantity    Int
  price       Float
  variantName String?

  @@map("order_items")
}

model Review {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  userId    String  @db.ObjectId
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  rating  Int
  title   String?
  comment String?
  images  String[]

  // Verification
  isVerifiedPurchase Boolean @default(false)
  helpfulVotes       Int     @default(0)

  // Moderation
  isApproved Boolean @default(false)
  isVisible  Boolean @default(true)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@map("reviews")
}

model Wishlist {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  userId    String         @unique @db.ObjectId
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("wishlists")
}

model Cart {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String     @unique @db.ObjectId
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model PaymentMethod {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeId  String   // Stripe payment method ID
  brand     String?
  last4     String?
  expMonth  Int?
  expYear   Int?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String             @id @default(auto()) @map("_id") @db.ObjectId
  userId    String             @db.ObjectId
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  priority  NotificationPriority @default(MEDIUM)
  isRead    Boolean            @default(false)
  isArchived Boolean           @default(false)
  metadata  Json?
  expiresAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId])
  @@index([type])
  @@index([priority])
  @@index([isRead])
  @@index([isArchived])
  @@index([createdAt])
  @@map("notifications")
}

model ChatMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  sender    ChatSender
  metadata  Json?
  isRead    Boolean  @default(false)
  sessionId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([sender])
  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_messages")
}

// Enums
enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum OrchidSize {
  SEEDLING
  SAPLING
  YOUNG_PLANT
  MATURE
  BLOOMING_SIZE
  SPECIMEN
}

enum ColorPattern {
  SOLID
  BICOLOR
  MULTICOLOR
  VARIEGATED
}

enum NotificationType {
  ORDER_CONFIRMATION
  ORDER_STATUS_UPDATE
  ORDER_SHIPPED
  ORDER_DELIVERED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  LOW_STOCK
  PROMOTION
  SYSTEM_ALERT
  SUPPORT_REPLY
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ChatSender {
  USER
  BOT
  HUMAN
}

enum AttributeType {
  TEXT
  NUMBER
  SELECT
  MULTISELECT
  RADIO
  CHECKBOX
  COLOR
  BOOLEAN
  DATE
  URL
  EMAIL
  PHONE
}
