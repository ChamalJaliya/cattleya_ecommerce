{
  "name": "cattleya-ecommerce",
  "version": "1.0.0",
  "description": "Premium orchid e-commerce platform",
  "private": true,
  "workspaces": [
    "cattleya-frontend",
    "cattleya-backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd cattleya-frontend && npm run dev",
    "dev:backend": "cd cattleya-backend && npm run start:dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd cattleya-frontend && npm run build",
    "build:backend": "cd cattleya-backend && npm run build",
    "install:all": "npm install && cd cattleya-frontend && npm install && cd ../cattleya-backend && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^15.3.4"
  }
}
