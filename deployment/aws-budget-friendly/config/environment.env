# 🌱 Cattleya Environment Configuration (Budget-Friendly)
# Copy this file to .env and update the values

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment
NODE_ENV=production
PORT=3001

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database (RDS)
DATABASE_URL=postgresql://cattleya_admin:your_password@your_rds_endpoint:5432/cattleya

# Database Pool Configuration
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# =============================================================================
# JWT CONFIGURATION
# =============================================================================

# JWT Secret (generate a strong secret)
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random

# JWT Expiration
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# =============================================================================
# AWS CONFIGURATION
# =============================================================================

# AWS Region
AWS_REGION=us-east-1

# S3 Bucket for file uploads
S3_BUCKET=cattleya-app-uploads
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key

# CloudFront Distribution (optional)
CLOUDFRONT_DOMAIN=your_cloudfront_domain.cloudfront.net

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# AWS SES Configuration
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=your_ses_access_key_id
SES_SECRET_ACCESS_KEY=your_ses_secret_access_key
SES_FROM_EMAIL=noreply@yourdomain.com

# Email Templates
EMAIL_TEMPLATE_ORDER_CONFIRMATION=order-confirmation
EMAIL_TEMPLATE_PASSWORD_RESET=password-reset
EMAIL_TEMPLATE_WELCOME=welcome

# =============================================================================
# PAYMENT CONFIGURATION
# =============================================================================

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Payment Currency
PAYMENT_CURRENCY=USD

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# CORS Configuration
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

# Redis Configuration (optional - for session storage)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# Cache TTL (in seconds)
CACHE_TTL_PRODUCTS=3600
CACHE_TTL_CATEGORIES=7200
CACHE_TTL_USER_SESSION=86400

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Level
LOG_LEVEL=info

# Log File Path
LOG_FILE_PATH=/opt/cattleya/logs/app.log

# CloudWatch Log Group
CLOUDWATCH_LOG_GROUP=/aws/ec2/cattleya-backend

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Health Check Endpoint
HEALTH_CHECK_ENDPOINT=/health

# Metrics Collection
ENABLE_METRICS=true
METRICS_PORT=9090

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/Disable Features
ENABLE_REVIEWS=true
ENABLE_WISHLIST=true
ENABLE_PRODUCT_COMPARISON=true
ENABLE_LOYALTY_PROGRAM=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=false

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Debug Mode (set to false in production)
DEBUG=false

# API Documentation
ENABLE_SWAGGER=true
SWAGGER_PATH=/api-docs

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Application Version
APP_VERSION=1.0.0

# Build Information
BUILD_DATE=2024-01-01
BUILD_COMMIT=unknown

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Database Backup
ENABLE_AUTO_BACKUP=true
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# =============================================================================
# NOTIFICATIONS
# =============================================================================

# Slack Webhook (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Discord Webhook (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================

# Google Analytics
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID

# Facebook Pixel
FACEBOOK_PIXEL_ID=your_facebook_pixel_id

# Google Tag Manager
GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX

# =============================================================================
# CUSTOM CONFIGURATION
# =============================================================================

# Add any custom environment variables below
CUSTOM_FEATURE_FLAG=false
CUSTOM_API_KEY=your_custom_api_key

# =============================================================================
# NOTES
# =============================================================================

# 1. Replace all 'your_*' values with actual values
# 2. Keep this file secure and never commit it to version control
# 3. Use AWS Secrets Manager for sensitive values in production
# 4. Update CORS_ORIGIN with your actual domain
# 5. Generate a strong JWT_SECRET using: openssl rand -base64 32
# 6. Test all configurations before deploying to production 